{
  "name": "linktime-desktop-agent",
  "version": "1.1.0",
  "description": "LinkTime Desktop Activity Tracker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "author": "LinkTime",
  "license": "MIT",
  "dependencies": {
    "active-win": "6.3.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.linktime.agent",
    "productName": "LinkTime",
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png"
    }
  }
}
