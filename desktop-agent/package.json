{
  "name": "linktime-desktop-agent",
  "version": "2.0.1",
  "description": "LinkTime Desktop Activity Tracker",
  "main": "main.js",
  "scripts": {
    "start":      "electron .",
    "dev":        "cross-env NODE_ENV=development electron . --dev",
    "dev-local":  "cross-env NODE_ENV=development LINKTIME_WS=ws://localhost:3002 electron . --dev",
    "build":      "electron-builder --win",
    "build-win":  "electron-builder --win",
    "build-mac":  "electron-builder --mac",
    "build-linux":"electron-builder --linux",
    "release":    "electron-builder --win --publish always"
  },
  "author": "LinkTime",
  "license": "MIT",
  "dependencies": {
    "active-win": "6.3.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.linktime.agent",
    "productName": "LinkTime",
    "copyright": "Copyright © 2026 LinkTime",
    "publish": [
      {
        "provider": "github",
        "owner": "Bzden4ik",
        "repo": "LinkTime"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "icon.png",
      "webapp/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "LinkTime.Setup.v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LinkTime",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon.png"
    }
  }
}
