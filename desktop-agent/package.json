{
  "name": "linktime-desktop-agent",
  "version": "1.0.0",
  "description": "LinkTime Desktop Activity Tracker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "author": "LinkTime",
  "license": "MIT",
  "dependencies": {
    "active-win": "6.3.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.linktime.agent",
    "productName": "LinkTime",
    "files": [
      "main.js",
      "settings.html",
      "webapp/**/*",
      "icon.png"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon.png"
    }
  }
}
